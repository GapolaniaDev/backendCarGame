# Postgres
POSTGRES_DB=nakama
POSTGRES_USER=nakama
POSTGRES_PASSWORD=

# Nakama
NAKAMA_SERVER_KEY=
NAKAMA_GWP_SECRET=
NAKAMA_CONSOLE_USER=admin
NAKAMA_CONSOLE_PASSWORD=
NAKAMA_CONSOLE_SIGNING_KEY=
NAKAMA_SESSION_ENCRYPTION_KEY=
NAKAMA_SESSION_REFRESH_ENCRYPTION_KEY=
NAKAMA_RUNTIME_HTTP_KEY=

TUNNEL_MODE=named
TUNNEL_DOMAIN=
TUNNEL_TOKEN=

# Cloudflare credentials for automated DNS setup (optional)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Grafana admin password (used by the grafana container)
GRAFANA_ADMIN_PASSWORD=

# In-app purchase receipt verification (plan T-24). Leave empty until the
# store accounts exist; empty = that store's receipts are rejected.
# IAP_MOCK=true accepts the mock receipts of the tests: dev / CI only.
IAP_MOCK=false
# App Store Connect > App > App-Specific Shared Secret.
IAP_APPLE_SHARED_SECRET=
# Google Play service account with access to the Android Publisher API.
# IAP_GOOGLE_PRIVATE_KEY is its PKCS#8 PEM on one line, newlines as 
.
IAP_GOOGLE_CLIENT_EMAIL=
IAP_GOOGLE_PRIVATE_KEY=
IAP_GOOGLE_PACKAGE_NAME=

# Rewarded ads (plan T-25): the "Private Key" of the LevelPlay S2S reward
# callback (LevelPlay dashboard > Apps > Set S2S callback). Empty = every
# callback is rejected and no ad reward is paid.
LEVELPLAY_S2S_PRIVATE_KEY=
